#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# --ignore-unfixable: drop advisories with no non-vulnerable release on the
# registry (e.g. braces GHSA-vfj7-8cjw-p6xm / CVE-2026-93687 has no patch yet).
# When a fix ships, the advisory becomes fixable and this check fails again.
aube audit --audit-level moderate --ignore-unfixable
